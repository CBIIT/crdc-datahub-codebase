SESSION_SECRET=XXXXX
SESSION_TIMEOUT=1200
VERSION=1.0
DATE=2022.05.19
# DocumentDB Configuration
DOCDB_ENDPOINT=127.0.0.1
DOCDB_PORT=27017
DOCDB_USERNAME=root
DOCDB_PASSWORD=XXXX
DOCDB_DB_NAME=crdc-datahub
# TLS is enabled when DOCDB_TLS is unset. Set false for local MongoDB without TLS.
# DOCDB_TLS=false
# Optional CA override. When unset, defaults to resources/aws-documentdb-certificate/global-bundle.pem
# DOCDB_CA_FILE=/path/to/global-bundle.pem
# Email Notification Config
EMAIL_SMTP_HOST=XXXX@XXXX
EMAIL_SMTP_PORT=25
# Additional Email Server Configuration
#EMAIL_USER=XXXX
#EMAIL_PASSWORD=XXXX
# Used this IDP if IDP is not present in the body
IDP=NIH
# NIH LOGIN Config
NIH_CLIENT_ID=XXXX
NIH_CLIENT_SECRET=XXXX
NIH_BASE_URL=https://stsstg.nih.gov
NIH_REDIRECT_URL=http://localhost:4010/profile
NIH_USERINFO_URL=https://stsstg.nih.gov/openid/connect/v1/userinfo
NIH_AUTHORIZE_URL=https://stsstg.nih.gov/auth/oauth/v2/authorize
NIH_TOKEN_URL=https://stsstg.nih.gov/auth/oauth/v2/token
NIH_LOGOUT_URL=https://stsstg.nih.gov/connect/session/logout
NIH_SCOPE=openid email profile
NIH_PROMPT=login
NODE_ENV=development
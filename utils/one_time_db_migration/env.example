CONNECTION_STRING="mongodb://username:password@localhost:27017/?authMechanism=DEFAULT&authSource=admin"
DATABASE_NAME="database_name"

# 3705 MongoDB backup / DocumentDB restore
BACKUP_CONNECTION_STRING="mongodb://username:password@source-host:27017/?authMechanism=DEFAULT&authSource=admin"
BACKUP_DATABASE_NAME="source_database_name"
RESTORE_DATABASE_NAME="documentdb_database_name"
BACKUP_DIRECTORY="/path/to/backup"
RESTORE_CONNECTION_STRING="mongodb://username:password@documentdb-host:27017/?tls=true&tlsCAFile=/path/to/global-bundle.pem&retryWrites=false"
